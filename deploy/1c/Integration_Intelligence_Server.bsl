#Область ИнтеграцияСWMS

Процедура УведомитьОСозданнойРеализацииWMS(Реализация) Экспорт

	Если НЕ ЗначениеЗаполнено(Реализация) Тогда
		Возврат;
	КонецЕсли;

	СсылкаРеализации = ПолучитьСсылкуОбъекта(Реализация);
	Если НЕ ЗначениеЗаполнено(СсылкаРеализации) Тогда
		Возврат;
	КонецЕсли;

	UIDДокумента = Строка(СсылкаРеализации.УникальныйИдентификатор());
	НомерДокумента = ПолучитьРеквизитОбъектаБезОшибки(СсылкаРеализации, "Номер", "");
	ДатаДокумента = ПолучитьРеквизитОбъектаБезОшибки(СсылкаРеализации, "Дата", Неопределено);
	Организация = ПолучитьРеквизитОбъектаБезОшибки(СсылкаРеализации, "Организация", Неопределено);
	Контрагент = ПолучитьРеквизитОбъектаБезОшибки(СсылкаРеализации, "Контрагент", Неопределено);

	Заголовок = "Створено накладну WMS №" + СокрЛП(Строка(НомерДокумента));
	Текст = "Необхідно роздрукувати накладну";

	Если ЗначениеЗаполнено(Организация) Тогда
		Текст = Текст + ". Організація: " + Организация.Наименование;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Текст = Текст + ". Контрагент: " + Контрагент.Наименование;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		Текст = Текст + ". Дата: " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
	КонецЕсли;

	Payload = Новый Структура;
	Payload.Вставить("type", "wms_invoice_created");
	Payload.Вставить("document_uid", UIDДокумента);
	Payload.Вставить("document_number", СокрЛП(Строка(НомерДокумента)));
	Payload.Вставить("document_type", "РеализацияТоваровУслуг");
	Если ЗначениеЗаполнено(Организация) Тогда
		Payload.Вставить("org_uid", Строка(Организация.УникальныйИдентификатор()));
	КонецЕсли;

	КоличествоПолучателей = 0;
	Для Каждого ПолучательСсылка Из ПолучитьПользователейМППоРоли(
		Перечисления.РолиМобильногоПриложения.ПолучатьУведомленияОтWMS
	) Цикл

		Получатель = ПолучательСсылка.ПолучитьОбъект();
		Если СобытиеWMSУжеСоздано(ПолучательСсылка, UIDДокумента) Тогда
			Продолжить;
		КонецЕсли;

		СоздатьСобытие(ПолучательСсылка, Заголовок, Текст, Payload);

		Токены = ПолучитьPushТокены(Получатель);
		Если Токены.Количество() > 0 Тогда
			ОтправитьPushЧерезFCM(Токены, Заголовок, Текст, Payload);
		КонецЕсли;

		КоличествоПолучателей = КоличествоПолучателей + 1;

	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"MOVA.WMS.InvoiceCreated",
		УровеньЖурналаРегистрации.Информация,
		UIDДокумента,
		"number=" + СокрЛП(Строка(НомерДокумента))
			+ "; recipients=" + Строка(КоличествоПолучателей)
	);

КонецПроцедуры

#КонецОбласти


#Область ОбщиеСобытияIntelligence

Функция ПолучитьПользователейМППоРоли(РольПроверки)

	Результат = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПользователиМобильногоПриложения КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПользовательМП = Выборка.Ссылка.ПолучитьОбъект();
		Если ЕстьРольМП(ПользовательМП, РольПроверки) Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьРольМП(ПользовательМП, РольПроверки)

	Для Каждого СтрокаРоли Из ПользовательМП.ДоступныеРоли Цикл
		Если ЗначениеЗаполнено(СтрокаРоли.Роль)
			И СтрокаРоли.Роль = РольПроверки Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СобытиеWMSУжеСоздано(ПользовательМП, UIDДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	События.ИДСобытия КАК ИДСобытия
		|ИЗ
		|	РегистрСведений.СобытияМобильногоПриложения КАК События
		|ГДЕ
		|	События.Пользователь = &Пользователь
		|	И События.ТипСобытия = &ТипСобытия
		|	И События.PayloadJSON ПОДОБНО &UIDДокумента";

	Запрос.УстановитьПараметр("Пользователь", ПользовательМП);
	Запрос.УстановитьПараметр("ТипСобытия", "wms_invoice_created");
	Запрос.УстановитьПараметр("UIDДокумента", "%" + UIDДокумента + "%");

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Процедура СоздатьСобытие(Пользователь, Заголовок, Текст, Payload)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Payload);
		PayloadJSON = ЗаписьJSON.Закрыть();
	Исключение
		PayloadJSON = "{}";
	КонецПопытки;

	ИДСобытия = Строка(Новый УникальныйИдентификатор());
	ДатаВремяСобытия = ТекущаяДата();
	Набор = РегистрыСведений.СобытияМобильногоПриложения.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.ИДСобытия.Установить(ИДСобытия);
	Набор.Отбор.ДатаВремяСобытия.Установить(ДатаВремяСобытия);

	ЗаписьСобытия = Набор.Добавить();
	ЗаписьСобытия.Пользователь = Пользователь;
	ЗаписьСобытия.ИДСобытия = ИДСобытия;
	ЗаписьСобытия.ДатаВремяСобытия = ДатаВремяСобытия;
	ЗаписьСобытия.ТипСобытия = "wms_invoice_created";
	ЗаписьСобытия.ЗаголовоСобытия = Лев(Заголовок, 150);
	ЗаписьСобытия.ТекстСобытия = Лев(Текст, 400);
	ЗаписьСобытия.Прочитано = Ложь;
	ЗаписьСобытия.PayloadJSON = PayloadJSON;
	Набор.Записать();

КонецПроцедуры

#КонецОбласти


#Область ОбщиеPushУведомления

Функция ПолучитьPushТокены(ПользовательМП)

	Результат = Новый Массив;
	Для Каждого Устройство Из ПользовательМП.МобильныеУстройства Цикл
		Если Устройство.Активно И НЕ ПустаяСтрока(Устройство.PushToken) Тогда
			Результат.Добавить(Устройство.PushToken);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОтправитьPushЧерезFCM(Токены, Заголовок, Текст, ДопДанные)

	Тело = Новый Структура;
	Тело.Вставить("tokens", Токены);
	Тело.Вставить("title", Заголовок);
	Тело.Вставить("body", Текст);
	Тело.Вставить("data", ДопДанные);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Тело);
	JSONСтрока = ЗаписьJSON.Закрыть();

	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", 8080);
		Запрос = Новый HTTPЗапрос("/send");
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.Заголовки.Вставить("x-api-key", "MOVA_SUPER_SECRET_KEY_DOND_CHANGE_ME");
		Запрос.УстановитьТелоИзСтроки(JSONСтрока, КодировкаТекста.UTF8);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				"MOVA.WMS.Push",
				УровеньЖурналаРегистрации.Ошибка,
				,
				"status=" + Строка(Ответ.КодСостояния)
					+ "; response=" + Ответ.ПолучитьТелоКакСтроку()
			);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"MOVA.WMS.Push",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОписаниеОшибки()
		);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти


#Область ОбщиеУтилиты

Функция ПолучитьСсылкуОбъекта(СсылкаИлиОбъект)

	Попытка
		Если ЗначениеЗаполнено(СсылкаИлиОбъект.Ссылка) Тогда
			Возврат СсылкаИлиОбъект.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат СсылкаИлиОбъект;

КонецФункции

Функция ПолучитьРеквизитОбъектаБезОшибки(СсылкаИлиОбъект, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено)

	Объект = СсылкаИлиОбъект;
	Попытка
		Объект = СсылкаИлиОбъект.ПолучитьОбъект();
	Исключение
	КонецПопытки;

	Попытка
		Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат Объект[ИмяРеквизита];
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти
